---
import Button from "./Button.astro"
---
<section id="hero-about" class="relative flex flex-col justify-end items-center w-full h-dvh min-h-screen bg-[url(../assets/images/about_bg.webp)] bg-no-repeat md:bg-cover bg-cover bg-center 2xl:pb-20 lg:pb-10 md:pb-40 pb-20">
    <div class="absolute inset-0 z-0 bg-linear-to-t from-black/70 rounded-sm"></div>
    <div class="flex flex-col justify-center items-center gap-15">
        <div class="flex flex-col md:justify-around justify-center items-center w-auto h-auto bottom-20 left gap-5 z-10">
            <h2 class="font-inter text-2xl md:text-3xl text-brand-peru-500 text-center">Slogan principal de la marca</h2>
            <h1 class="font-cormorant lg:text-8xl md:text-7xl text-5xl text-white text-center">Sobre Nosotros</h1>
        </div>
        <div id="hero-cta" class="flex flex-row w-[80%] justify-center items-center gap-10 z-10">
            <Button type="main" size="lg" link="/">Main</Button>
        </div>
    </div>
</section>