---
import type { Team } from '../types/team_types'
import Button from './Button.astro'

interface Props {
    team: Team[]
}

const {team}: Props = Astro.props

---
<section id="team-section" class="flex flex-col items-center w-full h-full min-h-screen mt-10 mb-10 before:w-[80%] before:h-[0.5px] before:bg-gray-200 before:mb-10">
    <div id="team-title" class="flex flex-col w-full h-auto p-5 gap-2 mb-20">
        <h2 class="font-inter text-2xl text-center text-brand-peru-500">Profesionales que conectan contigo</h2>
        <h3 class="font-cormorant font-bold text-4xl text-center text-brand-red-500">Nuestro equipo</h3>
    </div>
    <div id="team-cards" class="flex flex-col md:flex-col lg:flex-row items-center lg:items-baseline w-[90%] md:w-[90%] h-auto min-h-100 lg:min-h-100 gap-10">
        {team.filter((prof) => prof.available).map((prof) => (
            <div class="relative flex flex-col md:flex-row lg:flex-col justify-center items-center w-[80%] md:w-full lg:w-[80%] h-auto">
                <div id="first-card" class="flex flex-col justify-around items-center w-full md:max-w-75 md:min-w-75 h-80 p-2 bg-cover bg-no-repeat bg-center rounded-sm shadow-sm" style={`background-image: url("${prof.thumb_link}")`}>
                    <div class="relative flex flex-col justify-between w-full h-[80%]" >
                        <h3 class="absolute bottom-10 left-5 font-inter font-semibold text-white">{prof.name}</h3>
                        <p class="absolute bottom-5 left-5 font-inter text-white">{prof.profession}</p>
                    </div>
                    <div class="flex flex-row gap-5">
                        <Button type='second' size='sm' clase='card-button'>
                            ver más
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-down">
	                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
	                        <path d="M6 9l6 6l6 -6" />
                            </svg>
                        </Button>
                        <Button type="main" size="sm" link='/'>Pedir cita</Button> 
                    </div>
                </div>
                <div id="second-card" class="flex flex-col justify-center items-center w-full md:w-[85%] lg:w-75 h-70 rounded-sm shadow-sm z-10 overflow-hidden max-h-0 md:max-w-0 md:max-h-none md:h-80 lg:max-w-full lg:max-h-0 transition-[max-height,max-width] duration-500 ease-in-out">
                    <p class="flex flex-col justify-center w-full h-full p-5">{prof.description}</p>
                </div>
            </div>
        ))}
    </div>
</section>
<script>
    document.querySelectorAll(".card-button").forEach((button) => {
        button.addEventListener("click", () => {
            const card = button.closest(".relative.flex.flex-col.justify-center");
            const secondCard = card?.querySelector("#second-card");
            const arrow = button.querySelector("svg")
            const label = button.firstChild;
            
            secondCard?.classList.toggle("max-h-0")
            secondCard?.classList.toggle("max-h-70")
            secondCard?.classList.toggle("md:max-w-0")
            secondCard?.classList.toggle("md:max-w-[50%]")
            secondCard?.classList.toggle("lg:max-h-0")
            secondCard?.classList.toggle("lg:max-h-70")

            arrow?.classList.toggle("rotate-180")

            if(label){
                label.textContent = label.textContent?.trim() === "Ver menos" ? "Ver más" : "Ver menos"
            }
        });
    });
</script>

