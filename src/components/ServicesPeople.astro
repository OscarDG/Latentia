---
import Button from './Button.astro';
import ModalBtn from './ModalBtn.astro';
import type { Service } from '../types/services_types'
import Modal from './Modal.astro';
interface Props {
    service: Service[],
}

const {service}: Props = Astro.props;
---
<section id="services-people" class="flex flex-col justify-around items-center w-full h-auto min-h-screen gap-0 md:gap-10 pt-20 pb-20">
    <div id="services-people--maincard" class="flex flex-col md:flex-row w-[90%] md:w-[85%] lg:w-[80%] h-150 md:h-90 lg:h-115">
        <div class="w-full md:w-[50%] h-[40%] md:h-full bg-[url(../assets/images/servicePeople.webp)] bg-no-repeat bg-cover rounded-tl-sm rounded-tr-sm md:rounded-br-none md:rounded-tr-none md:rounded-bl-sm"></div>
        <div class="flex flex-col w-full md:w-[50%] h-auto min-h-80 md:h-full justify-around items-start rounded-br-sm rounded-bl-sm md:rounded-tr-sm md:rounded-tl-none md:rounded-br-sm md:rounded-bl-none bg-white drop-shadow-sm pl-5 md:pl-8 pr-5 md:pr-0 pt-5 md:pt-0 pb-5 md:gap-0 gap-5">
            <h2 class="text-3xl md:text-4xl text-brand-peru-500 font-cormorant">Servicios personales</h2>
            <p class=" w-full md:w-[80%] text-brand-gray-700 font-inter text-sm md:text-md">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer dignissim at odio a ultrices. Duis non imperdiet neque. In hac habitasse platea dictumst. Fusce eu tempus augue. Mauris urna mauris, luctus quis quam ac, placerat luctus dolor. Maecenas pulvinar est diam, ac lobortis quam tincidunt vitae. Phasellus feugiat quis diam eget commodo. Nam sit amet ultricies arcu.</p>
            <Button type='second' size='md' link='/'>Solicitar servicio</Button>
        </div>
    </div>
    <div id="services-people--secondCards" class="flex flex-col md:flex-row flex-wrap w-[80%] md:w-[90%] lg:w-[80%] h-auto md:h-auto justify-around items-center gap-10 padding-5">
        {service.map((service, index) => service.type === "Persons" && (
            <div class="relative flex flex-col w-65 md:w-75 md:h-85 h-70 rounded-sm bg-cover bg-no-repeat bg-center p-3" style={`background-image: url("${service.thumb_link}")`} people-animate>
                <div class="absolute inset-0 z-0 bg-linear-to-t from-black/70 rounded-sm"></div>
                <div class="flex flex-col w-full h-[70%] justify-around">
                    <h2 class="text-white font-inter text-2xl z-10">{service.title}</h2>
                    <p class="text-white font-inter text-sm z-10">{service.shortText}</p>
                </div>
                <div class="absolute bottom-6 right-6">
                    <ModalBtn modalId={`service-modal-${index}`} type='second' size='sm'>Ver más</ModalBtn>
                </div>
            </div>
            <Modal id={`service-modal-${index}`} title={service.title}>
                <h2 class="text-center font-cormorant text-3xl text-brand-peru-500">{service.title}</h2>
                <p class="text-left font-inter text-lg text-brand-gray-700">{service.mainText}</p>
                <ul class="flex flex-col justify-around text-brand-gray-700 text-lg font-inter p-5 h-auto">
                    {
                        service.features.map((feature) => (
                            <li class="flex flex-row gap-4 items-start">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                viewBox="0 0 24 24" fill="none" stroke="#C3803C"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M5 12l5 5l10 -10" />
                                </svg>

                                <span class="leading-snug">{feature}</span>
                            </li>
                        ))
                    }              
                </ul>
            </Modal>
          ))}
    </div>
</section>
<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
//OPEN MODAL
    document.addEventListener("click", (event) => {

        const target = event.target as HTMLElement;

        const trigger = target.closest(
            "[data-modal-target]"
        );

        if (!trigger) return;

        const modalId = 
        trigger.getAttribute("data-modal-target");

        if (!modalId) return;

        const modal = document.getElementById(
           modalId
        ) as HTMLDialogElement;

        modal?.showModal();

        document.body.style.overflow = "hidden"
    });

    //CLOSE BUTTON

    document.addEventListener("click", (event) => {

        const target = event.target as HTMLElement

        const closeBtn = target.closest("[data-modal-close]");

        if(!closeBtn) return;

        const modalId = closeBtn.getAttribute("data-modal-close");

        if(!modalId) return;

        const modal = document.getElementById(modalId) as HTMLDialogElement;

        modal?.close();

        document.body.style.overflow = "auto";

    });

    //BACKDROP CLICK
    document.querySelectorAll("dialog").forEach((dialog) => {

        dialog.addEventListener("click", (event) => {
            
            const rect = dialog.getBoundingClientRect();

            const isInside = 
                rect.top <= event.clientY &&
                event.clientY <= rect.bottom &&
                rect.left <= event.clientX &&
                event.clientX <= rect.right;

            if (!isInside) {

                (dialog as HTMLDialogElement).close();

                document.body.style.overflow = "auto";
            }
        });
    });

    //ESC

    document.addEventListener("keydown", (event) => {

        if(event.key === "Escape"){

            document.querySelectorAll("dialog").forEach((dialog) => {
                (dialog as HTMLDialogElement).close();
            });

            document.body.style.overflow = "auto";
        }
    });
</script>