---
import { Image } from "astro:assets";
import SearchIcon from "../assets/icons/search.webp";
import BookIcon from "../assets/icons/schedulle.webp";
import DateIcon from "../assets/icons/date.webp";
import JoyIcon from "../assets/icons/joy.webp";
---
<section id="aboutHow_people" class="flex flex-col w-full justify-center h-auto min-h-screen gap-5 md:gap-20 pt-10 pb-10 md:pb-10">
    <h2 class="font-cormorant text-4xl text-center text-brand-red-500">Cómo acceder a tu servicio</h2>
    <div id="mainGrid" class="grid grid-cols-3 grid-rows-3 w-full h-190 justify-around gap-2 p-10">
        <div data-step=4 class="flex flex-col items-center justify-center row-start-2 col-start-1 gap-2">
            <span><Image src={JoyIcon} alt="Search" class="md:w-50 w-20 md:h-50 h-20"/></span>
            <div class="flex flex-col items-center justify-center gap-2">
                <p class="font-inter font-bold text-brand-peru-500 text-center text-lg md:text-2xl">Paso 4</p>
                <p class="font-inter font-bold text-brand-peru-400 text-center text-md md:text-xl">Disfruta tu bienestar</p>
            </div>
        </div>
        <div data-step=1 class="flex flex-col items-center justify-center row-start-1 col-start-2 gap-2">
            <span><Image src={SearchIcon} alt="Book" class="w-20 md:w-50 h-20 md:h-50"/></span>
            <div class="flex flex-col items-center justify-center gap-2">
                <p class="font-inter font-bold text-brand-peru-500 text-center text-lg md:text-2xl">Paso 1</p>
                <p class="font-inter font-bold text-brand-peru-400 text-center text-md md:text-xl">Selecciona tu terapeuta</p>
            </div>
        </div>
        <div data-step=2 class="flex flex-col items-center justify-center row-start-2 col-start-3 gap-2">
            <span><Image src={BookIcon} alt="Date" class="w-20 md:w-50 h-20 md:h-50"/></span>
            <div class="flex flex-col items-center justify-center gap-2">
                <p class="font-inter font-bold text-brand-peru-500 text-center text-lg md:text-2xl">Paso 2</p>
                <p class="font-inter font-bold text-brand-peru-400 text-center text-md md:text-xl">Agenda tu cita</p>
            </div>
        </div>
        <div data-step=3 class="flex flex-col items-center justify-center row-start-3 col-start-2 gap-2">
            <span><Image src={DateIcon} alt="Joy" class="w-20 md:w-50 h-20 md:h-50"/></span>
            <div class="flex flex-col items-center justify-center gap-2">
                <p class="font-inter font-bold text-brand-peru-500 text-center text-lg md:text-2xl">Paso 3</p>
                <p class="font-inter font-bold text-brand-peru-400 text-center text-md md:text-xl">Asiste a tu sesión</p>
            </div>
        </div>
    </div>
</section>
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const steps = [1, 2, 3, 4].map(n =>
    document.querySelector(`[data-step="${n}"]`)
  );

  gsap.set(steps, { opacity: 0, y: 40 });

  const tl = gsap.timeline({ paused: true });

  tl.to(steps[0], { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" })
    .to(steps[1], { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" }, "+=0.1")
    .to(steps[2], { opacity: 1, y: 0, duration: 1, ease: "power2.out" }, "+=0.1")
    .to(steps[3], { opacity: 1, y: 0, duration: 1.5, ease: "power2.out" }, "+=0.1");

  ScrollTrigger.create({
    trigger: "#mainGrid",
    start: "top 50%",
    once: true,
    onEnter: () => tl.play(),
  });
</script>