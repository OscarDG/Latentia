<section class="relative flex flex-col w-full h-auto min-h-screen justify-around items-center pt-10 pb-10 before:w-[80%] before:h-[0.5px] before:bg-gray-200 before:mb-10">
    <div class="flex flex-col justify-center items-center w-full h-auto gap-5 mb-20">
