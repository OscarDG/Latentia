                    <p class="text-center text-sm text-brand-blue-900">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const cards = gsap.utils.toArray("[card-animate]") as HTMLElement[];

  cards.forEach((card) => {

    gsap.fromTo(
      card,
      { y: 120 },
      {
        y: 0,
        duration: 0.7,
        ease: "none",
        scrollTrigger: {
          trigger: card,
          start: "top 90%",   // animation starts when card enters viewport
          end: "top 90%",
          once: true,     // animation completes here
          scrub: 0.8,           // ties animation to scroll (1 = slight smoothing)
          toggleActions: "play reverse play reverse", // in and out
        },
      }
    );
  });
</script>