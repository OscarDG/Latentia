---
import Button from './Button.astro';
import type { Service } from '../types/services_types'

interface Props {
    service: Service[],
}

const {service}: Props = Astro.props;
---
<section id="services-people" class="flex flex-col justify-around items-center w-full h-auto min-h-screen mt-15 mb-15 gap-0 md:gap-10">
    <div id="services-people--maincard" class="flex flex-col md:flex-row w-[90%] md:w-[85%] lg:w-[80%] h-150 md:h-90 lg:h-115">
        <div class="w-full md:w-[50%] h-[40%] md:h-full bg-[url(../assets/images/servicePeople.webp)] bg-no-repeat bg-cover rounded-tl-sm rounded-tr-sm md:rounded-br-none md:rounded-tr-none md:rounded-bl-sm"></div>
        <div class="flex flex-col w-full md:w-[50%] h-80 md:h-full justify-around items-start border md:border-t md:border-r md:border-b md:border-l-0 rounded-br-sm rounded-bl-sm md:rounded-tr-sm md:rounded-tl-none md:rounded-br-sm md:rounded-bl-none pl-5 md:pl-8 pr-5 md:pr-0 pt-5 md:pt-0 pb-2">
            <h2 class="text-3xl md:text-4xl text-brand-blue font-cormorant">Servicios personales</h2>
            <p class=" w-full md:w-[80%] text-brand-gray-700 font-inter text-sm md:text-md">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer dignissim at odio a ultrices. Duis non imperdiet neque. In hac habitasse platea dictumst. Fusce eu tempus augue. Mauris urna mauris, luctus quis quam ac, placerat luctus dolor. Maecenas pulvinar est diam, ac lobortis quam tincidunt vitae. Phasellus feugiat quis diam eget commodo. Nam sit amet ultricies arcu.</p>
            <Button type='second' size='md' link='/'>Second</Button>
        </div>
    </div>
    <div class="flex flex-col md:flex-row flex-wrap w-[80%] md:w-[90%] lg:w-[80%] h-auto md:h-auto justify-around items-center gap-10 padding-5">
        {service.map((service) => (
            <div class="relative flex flex-col w-65 md:w-75 md:h-85 h-70 rounded-sm bg-cover bg-no-repeat bg-center p-3" style={`background-image: url("${service.thumb_link}")`}>
                <div class="absolute inset-0 z-0 bg-linear-to-t from-black/70"></div>
                <div class="flex flex-col w-full h-[70%] justify-around">
                    <h2 class="text-white font-inter text-2xl z-10">{service.title}</h2>
                    <p class="text-white font-inter text-sm z-10">{service.text}</p>
                </div>
                <div class="absolute bottom-6 right-6">
                    <Button type='second' size='sm' link='/'>Main</Button>
                </div>
            </div>
          ))}
    </div>
</section>