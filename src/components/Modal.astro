---
import Button from './Button.astro';

interface Props {
  id: string;
  title?: string;
}

const { id, title = "Modal" } = Astro.props;
---

<dialog id={id} data-modal={id} class="modal-dialog fixed inset-0 md:top-20 top-5 md:left-52 left-5 pt-10 pb-10 rounded-sm bg-brand-gray-100 items-center justify-center z-50 md:w-[70%] w-full md:h-[80%] h-full drop-shadow-gray-500 drop-shadow-md transition-all ease-in-out animate-show">
  <div class="modal-content flex flex-col w-full h-full justify-between items-center gap-2 pb-1">
    <header class="modal-header absolute top-0 flex flex-row justify-between items-center h-10 w-full p-5">
      <button
        type="button"
        class="close-btn absolute right-5 top-5 group flex cursor-pointer rounded-full bg-brand-peru-300 hover:bg-brand-peru-500 h-6 md:h-10 w-6 md:w-10 justify-center items-center" data-modal-close={id} aria-label="Cerrar modal"
      >
        <svg class="w-4 md:w-6 h-4 md:h-6 icon icon-tabler icons-tabler-outline icon-tabler-x" 
              xmlns="http://www.w3.org/2000/svg" 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="#5A3B1C" 
              stroke-width="2" 
              stroke-linecap="round" 
              stroke-linejoin="round">
	        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
	        <path d="M18 6l-12 12" />
	        <path d="M6 6l12 12" />
        </svg>
      </button>
    </header>
    <div class="modal-body flex flex-col justify-between align-center w-[90%] md:w-[80%] h-[95%] md:h-[90%] mb-5 gap-10">
      <slot />
    </div>
    <footer class="modal-footer flex flex-row justify-center w-[90%] md:w-[30%]">
      <slot name="footer">
        <Button type='main' size='md' link='/'>Solicitar Servicio</Button>
      </slot>
    </footer>
  </div>
</dialog>
<style>
  @keyframes spin-cw {
    from{
      transform: rotate(0deg);
    }
    to{
      transform: rotate(180deg);
    }
  }

  @keyframes spin-ccw {
    from{
      transform: rotate(180deg);
    }
    to{
      transform: rotate(0deg);
    }
  }

  .close-btn{
    animation: spin-ccw 1s ease-in-out forwards;
  }

  .close-btn.hovered{
    animation: spin-cw 1s ease-in-out forwards;
  }
</style>
<script>

  document.querySelectorAll(".close-btn").forEach((btn) => {
 
    const el = btn as HTMLElement;

     el.addEventListener('mouseenter', () => {
        el.classList.remove("hovered");
        // force reflow
        void (el.offsetWidth);
        el.classList.add("hovered");
      });

      el.addEventListener('mouseleave', () => {
        el.classList.remove("hovered");
        // force reflow
        void (el.offsetWidth);
      });
  });
</script>