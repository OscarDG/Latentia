---
interface Props {
    size: "sm" | "md" | "lg",
    type: "main" | "second"|"thirth",
    state?: Boolean,
    link?: string,
    clase?: string
}

const {size = "md", type = "main", state = true, link, clase} = Astro.props;

const base = "flex items-center justify-center items-center rounded-sm font-inter z-10 transition ease-in-out cursor-pointer gap-2";

const sizes = {
  sm: "min-w-25 min-h-8 text-sm px-4 py-2",
  md: "min-w-30 min-h-10 text-md px-4 py-2",
  lg: "min-w-40 min-h-12 text-lg px-4 py-2",
};

const variants = {
  main:
    "bg-brand-red-700 text-white hover:bg-brand-red-600 hover:scale-102",
  thirth:
    "border border-brand-peru-400 text-brand-peru-400 hover:bg-brand-peru-400 hover:border-transparent hover:text-brand-peru-900",
  second:
    "bg-brand-peru-500 text-white hover:bg-brand-peru-400 hover:scale-102"
};

const disabled = !state
  ? "opacity-50 pointer-events-none"
  : "";
---

<a href={link} class:list={[clase, base, variants[type], sizes[size], disabled ]}>
    <slot />
</a>