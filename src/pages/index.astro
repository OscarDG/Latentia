---
import MainLayout from "../layouts/MainLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import ServicesPeople from "../components/ServicesP.astro";
import ServicesCorporative from "../components/ServicesCorporative.astro";
import Features from "../components/Features.astro";
import Team from "../components/Team.astro";
import BannerHome from "../components/BannerHome.astro";
import { services } from "../data/services"
import { team } from "../data/team";
const title = "Latentia";
---
<MainLayout title={title}>
    <HeroSection />
    <ServicesPeople service={services}/>
    <ServicesCorporative service={services}/>
    <Features />
    <Team team={team}/>
    <BannerHome />
</MainLayout>	