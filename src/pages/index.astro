---
import MainLayout from "../layouts/MainLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import ServicesPeople from "../components/ServicesPeople.astro";
import ServicesCorporative from "../components/ServicesCorporative.astro";
import Features from "../components/Features.astro";
import { services } from "../data/services"
const title = "Latentia";
---
<MainLayout title={title}>
    <HeroSection />
    <ServicesPeople service={services}/>
    <ServicesCorporative service={services}/>
    <Features />
</MainLayout>	